# Ollama base URL (pointing to local serve on port 7860)
OLLAMA_BASE_URL=http://localhost:7860

# GLM 5.3 generation through the dedicated OpenAI-compatible vLLM endpoint
VLLM_BASE_URL=http://171.232.252.135:31585/v1
VLLM_MODEL=glm53-flash
VLLM_API_KEY=replace-with-your-bearer-token

# Embedding model for retrieval (Ollama)
EMBEDDING_MODEL=bge-m3:latest

# Chroma persistence directory and collection name
CHROMA_DIR=./data/chroma_dmom
CHROMA_COLLECTION=dmom_qa

# Defaults for chunking and retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
